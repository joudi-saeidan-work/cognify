{
  "name": "Cognify Audio Recorder",
  "short_name": "Audio Recorder",
  "description": "Start speaking and leave the rest to us",
  "icons": [
    {
      "src": "/icons/android-chrome-192x192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/icons/android-chrome-512x512.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "/icons/favicon.ico",
      "type": "image/x-icon",
      "sizes": "48x48"
    },

    {
      "src": "/icons/favicon-16x16.png",
      "type": "image/png",
      "sizes": "16x16"
    },
    {
      "src": "/icons/favicon-32x32.png",
      "type": "image/png",
      "sizes": "32x32"
    },
    {
      "src": "/icons/apple-touch-icon.png",
      "type": "image/png",
      "sizes": "180x180"
    }
  ],
  "start_url": "/install/audio-recorder/",
  "scope": "/install/audio-recorder/",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "theme_color": "#000000",
  "orientation": "portrait"
}
